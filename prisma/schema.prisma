model cancellation_feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  reason     String
  feedback   String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum edit_change_type {
  added
  deleted
  modified
  status_change
  meta_change
  restored
}

model taxonomy_units {
  code          String   @id
  name          String
  kind          String   @default("owner")
  groups        Json?
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

model taxonomy_topics {
  code               String   @id
  label              String
  topic_type         String
  home_unit          String
  group_code         String?
  cross_refs         Json?
  variants           Json?
  depth              String   @default("Core")
  status             String   @default("active")
  merged_into        Json?
  cross_cutting_tags Json?
  taxonomy_version   String   @default("1.1")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([home_unit], map: "idx_taxonomy_topics_home_unit")
  @@index([depth], map: "idx_taxonomy_topics_depth")
  @@index([status], map: "idx_taxonomy_topics_status")
}

model stripe_webhook_events {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String   @unique
  event_type   String
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([event_id], map: "idx_stripe_webhook_events_event_id")
}

